# Canaries are evidence, and evidence only works if it is not public.
# A canary published here could be filtered out of training data, and worse, a
# model reproducing it could no longer be said to have scraped the site -- it
# might have read this repository. Both files carry live canary values.
canary.db
decoys/

# Scraped output: regenerated by scraper_demo.py, and carries canaries too.
scraped/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Android build output and machine-specific paths
repelnt-android/local.properties
repelnt-android/.gradle/
repelnt-android/build/
repelnt-android/app/build/
*.apk

# Compiled jars, except the Gradle wrapper, which belongs in version control
*.jar
!repelnt-android/gradle/wrapper/gradle-wrapper.jar

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
